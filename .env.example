# Kopieer dit bestand naar .env en vul je sleutels in. .env komt NIET in git.

# Claude API-sleutel (https://console.anthropic.com -> API Keys).
# Zonder sleutel werkt de app ook, maar dan kiest hij clips alleen op geluid/beeld.
ANTHROPIC_API_KEY=

# Pad naar het OAuth-clientbestand dat je downloadt uit Google Cloud Console
# (type "Desktop app"). Zie README, stap "YouTube koppelen".
GOOGLE_CLIENT_SECRET_FILE=client_secret.json

# Optioneel: poort van de webapp
PORT=8765
